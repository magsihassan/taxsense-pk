# ==============================================================================
# TaxSense PK — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Unit tests, coverage & typing caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# uv package manager
uv.lock

# ------------------------------------------------------------------------------
# 3. Node & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build outputs
dist/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/

# Local env files for frontend
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 4. Large Data, Documents & Model Caches
# ------------------------------------------------------------------------------
# Raw document sources (keep repo lightweight, download via ingestion script)
data/raw_docs/*.pdf
data/processed/
data/chunks/
data/test_salary_slips/
data/raw_docs/test_salary_slips/

# HuggingFace & PyTorch model cache
models_cache/
hf_cache/
.cache/
*.faiss
*.index
*.pkl

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & AI Tool Artifacts
# ------------------------------------------------------------------------------
# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Antigravity / Gemini / Agent Local Artifacts
.gemini/
.agent/
frontend/.agents/

# Impeccable Local Artifacts, Product & Design Briefs
PRODUCT.md
DESIGN.md
product.md
design.md
.impeccable/

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
tmp/
temp/